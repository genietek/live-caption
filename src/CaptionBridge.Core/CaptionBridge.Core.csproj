<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral logic: caption extraction engine, insertion policy, settings model.
       No Windows APIs here, so it is unit tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>CaptionBridge.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CaptionBridge.Tests" />
  </ItemGroup>

</Project>
