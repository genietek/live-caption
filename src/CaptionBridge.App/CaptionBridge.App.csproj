<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Lets the project build on non-Windows machines. It only runs on Windows 10/11. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>CaptionBridge</AssemblyName>
    <RootNamespace>CaptionBridge</RootNamespace>
    <Version>0.4.7</Version>
    <Product>CaptionBridge</Product>
    <Company>Genie</Company>
    <Authors>Genie</Authors>
    <Copyright>© 2026 Genie</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Description>Types Windows Live Captions into the focused textbox.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lower memory: no background GC thread, and the single-file exe is not compressed, so .NET maps its
         assemblies from the file instead of unpacking a copy of each into memory at startup. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF (UI + System.Windows.Automation) and WinForms (tray icon only) from the Windows Desktop runtime.
         Referenced directly instead of UseWPF/UseWindowsForms so the project also builds with .NET SDKs that
         lack the WindowsDesktop MSBuild SDK. The UI is built in C#, no XAML. No third-party packages. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo for the window, taskbar and tray (the exe icon comes from ApplicationIcon above). -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="CaptionBridge.app.ico" />
    <!-- Tray icon while Auto Insert is off: the logo on a gray background. -->
    <EmbeddedResource Include="Assets\app-off.ico" LogicalName="CaptionBridge.app-off.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaptionBridge.Core\CaptionBridge.Core.csproj" />
  </ItemGroup>

</Project>
